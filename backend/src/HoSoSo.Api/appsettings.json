{
  "ConnectionStrings": {
    "HoSo": ""
  },
  "Auth": {
    "Mode": "Oidc",
    "Authority": "",
    "ClientId": "hoso-web",
    "ClientSecret": "",
    "CookieName": "__Host-hoso",
    "SecureCookie": true,
    "SessionHours": 8,
    "PublicOrigin": "",
    "DataProtectionKeysPath": "",
    "DataProtectionCertificatePath": "",
    "MfaRequiredRoles": "technical_admin,chair,council,clerk"
  },
  "PdfSandbox": {
    "Mode": "Process",
    "TimeoutSeconds": 30,
    "MaxMemoryMb": 1536,
    "MaxConcurrency": 2,
    "MaxOutputMb": 64
  },
  "Storage": {
    "Provider": "Local",
    "Root": "/var/lib/hoso/blobs",
    "S3": {
      "ServiceUrl": "",
      "Region": "us-east-1",
      "Bucket": "",
      "ForcePathStyle": true,
      "Prefix": "",
      "ServerSideEncryption": ""
    }
  },
  "Limits": {
    "UploadMaxBytes": 209715200,
    "RequestsPerMinute": 300,
    "OpsRequestsPerMinute": 20,
    "AiExtractPerMinute": 20,
    "MaxPdfPages": 500
  },
  "Ai": {
    "BackgroundPriority": 7,
    "ExtractMaxDocuments": 50
  },
  "Antivirus": {
    "Enabled": false,
    "Host": "127.0.0.1",
    "Port": 3310,
    "TimeoutSeconds": 60,
    "FailOpen": false
  },
  "Backup": {
    "MaxAgeHours": 26,
    "RestoreTestMaxDays": 100,
    "StuckRunningHours": 12,
    "WatchdogMinutes": 15
  },
  "Observability": {
    "SlowRequestMs": 2000
  },
  "ErrorTracking": {
    "Dsn": "",
    "Environment": "production"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}

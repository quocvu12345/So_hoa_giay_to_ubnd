# Sao thành .env rồi nạp vào môi trường (launchd/systemd đọc từ tệp này). KHÔNG đưa bí mật thật vào repo.

# Hồ sơ phần cứng: mac-mlx (Mac Apple Silicon) | linux-cuda | cpu | fake (giả lập, chỉ để thử luồng)
HOSO_AI_PROFILE=mac-mlx

# Kết nối CSDL bằng role hoso_ai_worker (migration 020). Role tạo NOLOGIN: đặt mật khẩu ngoài repo,
# ví dụ: ALTER ROLE hoso_ai_worker LOGIN PASSWORD '...';
HOSO_AI_DATABASE_URL=postgresql://hoso_ai_worker@127.0.0.1:5432/hoso_dev

# Kho tệp: cùng thư mục với Storage:Root của API (API ghi blobs/ab/cd/<sha256>, worker chỉ đọc).
HOSO_AI_STORAGE_ROOT=/Volumes/quocDisk/Project/So_hoa_giay_to_ubnd/data/blobs
HOSO_AI_WORK_ROOT=/Volumes/quocDisk/Project/So_hoa_giay_to_ubnd/data/ai-work

# Nơi đặt mô hình và môi trường Python của bản thí điểm (document_ai/)
DOCUMENT_AI_HOME=/Volumes/quocDisk/AI/paddleocr

# Tùy chọn (mặc định trong ngoặc)
# HOSO_AI_MODEL_BUDGET_GB=6        # RAM tối đa cho mô hình nạp cùng lúc; máy 16 GB chỉ nên một mô hình nặng
# HOSO_AI_POLL_SECONDS=15
# HOSO_AI_HEARTBEAT_SECONDS=30
# HOSO_AI_MAX_ATTEMPTS=3
# HOSO_AI_MAX_PAGES=500
# HOSO_AI_PAGE_TIMEOUT_SECONDS=300
# HOSO_AI_HTTP_PORT=9108           # /health và /metrics, chỉ nghe 127.0.0.1

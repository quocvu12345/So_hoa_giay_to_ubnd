# Sao thành .env rồi nạp vào môi trường (launchd/systemd đọc từ tệp này). KHÔNG đưa bí mật thật vào repo.

# Hồ sơ phần cứng: mac-mlx (Mac Apple Silicon) | linux-cuda | cpu | fake (giả lập, chỉ để thử luồng)
HOSO_AI_PROFILE=mac-mlx

# Kết nối CSDL bằng role hoso_ai_worker (migration 020). Role tạo NOLOGIN: đặt mật khẩu ngoài repo,
# ví dụ: ALTER ROLE hoso_ai_worker LOGIN PASSWORD '...';
HOSO_AI_DATABASE_URL=postgresql://hoso_ai_worker@127.0.0.1:5432/hoso_dev

# Kho tệp: cùng thư mục với Storage:Root của API (API ghi blobs/ab/cd/<sha256>, worker chỉ đọc).
HOSO_AI_STORAGE_ROOT=/Volumes/quocDisk/Project/So_hoa_giay_to_ubnd/data/blobs
HOSO_AI_WORK_ROOT=/Volumes/quocDisk/Project/So_hoa_giay_to_ubnd/data/ai-work

# Nơi đặt mô hình và môi trường Python của bản thí điểm (document_ai/)
DOCUMENT_AI_HOME=/Volumes/quocDisk/AI/paddleocr

# Tùy chọn (mặc định trong ngoặc)
# HOSO_AI_MODEL_BUDGET_GB=7        # RAM tối đa cho mô hình nạp cùng lúc. 7 GB giữ được OCR (4,5) và Qwen3-1.7B (2); dùng mô hình lớn hơn thì tăng
# HOSO_AI_POLL_SECONDS=15
# HOSO_AI_HEARTBEAT_SECONDS=30
# HOSO_AI_MAX_ATTEMPTS=3
# HOSO_AI_MAX_PAGES=500
# HOSO_AI_PAGE_TIMEOUT_SECONDS=300
# HOSO_AI_HTTP_PORT=9108           # /health và /metrics, chỉ nghe 127.0.0.1

# Mô hình phân loại và trích trường (AI-13, AI-14): tên thư mục trong $DOCUMENT_AI_HOME/models. Mặc định Qwen3-1.7B-4bit.
# Có phần cứng tốt hơn: tải mô hình lớn hơn (python -m document_ai.download --model classifier_4b), đặt tên thư mục ở đây, tăng HOSO_AI_MODEL_BUDGET_GB.
# Thiếu thư mục thì worker dừng ngay lúc khởi động và liệt kê các mô hình đang có.
# HOSO_AI_CLASSIFIER_MODEL=Qwen3-1.7B-4bit
# HOSO_AI_CLASSIFIER_GB=2.0        # RAM ước tính của mô hình trên (để chia ngân sách); mặc định theo bảng trong document_ai/config.py

# Khay nền (AI-15). Việc có ocr_jobs.priority từ mức này trở lên là khay nền: chỉ chạy khi hết việc có người chờ, và nhường chỗ sau trang hiện tại.
# HOSO_AI_BACKGROUND_FROM=7
# Khung giờ khay nền được chạy, theo giờ máy; để trống thì bất cứ lúc nào rảnh. Việc có người chờ không bị khung giờ chặn.
# Ví dụ: nghỉ trưa, ban đêm và cuối tuần.
# HOSO_AI_BACKGROUND_WINDOWS=11:30-13:30,17:30-07:30,sat,sun
# Thu hẹp ứng viên bằng từ khóa trước khi hỏi mô hình (AI-20): chỉ đưa vài nhóm và loại khớp tiêu đề nhất; tài liệu tự ghi tên loại ở đầu trang thì tin chữ đó. Cần cho mô hình nhỏ (1.7B).
# HOSO_AI_SHORTLIST=on
# Kiểu lời nhắc trích trường (AI-14): production (chính xác hơn) | short (nhanh hơn). Việc có người chờ và việc nền có thể dùng kiểu khác nhau.
# HOSO_AI_PROMPT_INTERACTIVE=short      # việc có người chờ: nhanh khoảng 3 lần
# HOSO_AI_PROMPT_BACKGROUND=production  # khay nền: không ai chờ nên dùng bản chính xác hơn

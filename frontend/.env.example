# Sao chép thành .env.local khi chạy dev. Không đưa .env.local vào git.

# development | staging | production
HOSO_ENV=development

# 1 = chạy với dữ liệu giả lập, không cần API .NET (không được bật khi production)
HOSO_MOCK=1

# Địa chỉ API .NET từ phía máy chủ Next (không lộ ra trình duyệt). Bỏ trống khi HOSO_MOCK=1.
# HOSO_API_INTERNAL_URL=http://localhost:5080

# Tên cookie phiên do API .NET đặt. Dev: hoso_session_dev. Production: __Host-hoso (bắt buộc HTTPS).
# HOSO_SESSION_COOKIE=hoso_session_dev

# debug để ghi cả log gọi API thành công
# HOSO_LOG_LEVEL=info

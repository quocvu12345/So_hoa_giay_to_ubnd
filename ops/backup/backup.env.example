# Sao thành /etc/hoso/backup.env (chmod 600). Bí mật (mật khẩu CSDL, khóa máy) ở đây hoặc trong ~/.pgpass, KHÔNG đưa vào repo.

# --- CSDL: biến chuẩn của PostgreSQL. Mật khẩu để trong ~/.pgpass hoặc PGPASSFILE.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=hoso_backup          # role chỉ đọc đủ cho pg_dump; diễn tập khôi phục cần quyền CREATEDB (HOSO_RESTORE_PGUSER bên dưới)
PGDATABASE=hoso

# --- Nơi lưu
HOSO_BACKUP_DIR=/var/backups/hoso                 # sẽ có db/, files/, config/, restore-tests/
HOSO_BLOBS_DIR=/var/lib/hoso/blobs                # cùng Storage:Root của API
HOSO_RETENTION_DAYS=30                            # bản CSDL cũ hơn thế bị xóa, nhưng luôn giữ 3 bản mới nhất

# --- Báo kết quả về API (BE-89). Khóa trùng Backup__IngestToken của API (từ 32 ký tự).
HOSO_API_URL=http://127.0.0.1:5080
HOSO_BACKUP_TOKEN=

# --- Tùy chọn
# HOSO_CONFIG_PATHS="/etc/hoso/appsettings.Production.json /etc/caddy/Caddyfile"   # KHÔNG liệt kê tệp chứa bí mật; không có thì bỏ qua bản sao cấu hình
# HOSO_OFFSITE_CMD="rclone sync /var/backups/hoso remote:hoso-backup"              # chép ra ngoài địa điểm (bản ngoài nên không sửa/xóa được: object lock, WORM)
# HOSO_RESTORE_PGUSER=postgres                                                     # người dùng tạo/xóa CSDL tạm khi diễn tập khôi phục
